# === MedlarTV Core Settings ===
CORE_URL=http://127.0.0.1:8000
OLLAMA_URL=http://127.0.0.1:11434
MODEL_NAME=llama3
MEDLARTV_DEBUG=false

# === WebSocket Bridge Settings ===
BRIDGE_URL=ws://127.0.0.1:8765

# === LLM Behavior ===
MEDLARTV_MAX_HISTORY=10
MEDLARTV_MAX_TOKENS=150
MEDLARTV_TEMPERATURE=0.8
MEDLARTV_TOP_P=0.95
MEDLARTV_RETRY=25

# === Translation ===
ENABLE_TRANSLATION=true
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,ja,ko,pt
LIBRETRANSLATE_URL=https://translate.argosopentech.com/translate
LLAMA_REFINE=true
TRANSLATION_FALLBACK_LANGUAGE=en

# === Response Templates ===
ENABLE_RESPONSE_TEMPLATES=true
MIN_TEMPLATE_VARIATION=3

# === Moderation ===
ENABLE_AUTO_MOD=true
MOD_LINK_FILTER=true
MOD_CAPS_FILTER=true
MOD_SPAM_FILTER=true
ENABLE_STREAM_MANAGEMENT=true
ENABLE_RAID_DETECTION=true
ENABLE_SUB_DETECTION=true
ENABLE_CHANNEL_POINTS=true
ENABLE_EMOTE_RESPONSES=true

# === Rate Limiting ===
COOLDOWN_SECONDS=8
MAX_USER_COOLDOWN=30

# === Interaction Logging ===
ENABLE_INTERACTION_LOGGING=true
LOG_DIRECTORY=logs
MEDLARTV_DEBUG=true

# === Web Search Settings ===
ENABLE_WEB_SEARCH=true
ENABLE_WIKIPEDIA=true
WEB_SEARCH_MAX_RESULTS=3
WIKIPEDIA_LANG=en

# === Commands Site ===
COMMANDS_URL=https://DevilMedlar.github.io/medlar-commands-site/
# To Update
# When MedlarTV/config/commands.yaml changes:
# Re-run: .\.venv\Scripts\python.exe MedlarTV\tools\build_commands_site.py --out C:\Users\znorr\medlar-commands-site\docs
# Then git add docs && git commit -m "Update commands" && git push
# Pages will update automatically. No Codespaces or Actions minutes required.
