# === Twitch Bot Settings ===
TWITCH_NICK=medlartv
TWITCH_CHANNEL=#devilmedlar
TWITCH_TOKEN=oauth:6swjyhs9b4rd2x1aub6jd7o5u1azhh

# === MedlarTV Core Settings ===
CORE_URL=http://127.0.0.1:8000
OLLAMA_URL=http://127.0.0.1:11434

# === WebSocket Bridge Settings ===
BRIDGE_URL=ws://127.0.0.1:8765

# === Optional: LLM Configuration ===
MODEL_NAME=llama3
MEDLARTV_MAX_HISTORY=10
MEDLARTV_MAX_TOKENS=150
MEDLARTV_TEMPERATURE=0.8
MEDLARTV_TOP_P=0.95
MEDLARTV_RETRY=25

# === Twitch Message Limits ===
MAX_MESSAGE_LENGTH=500

# === Feature Flags (Quick Win 1) ===
# Multi-Language Support
ENABLE_TRANSLATION=true
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,ja,ko,pt

# Response Templates
ENABLE_RESPONSE_TEMPLATES=true
MIN_TEMPLATE_VARIATION=3

# Moderation
ENABLE_AUTO_MOD=true
MOD_LINK_FILTER=true
MOD_CAPS_FILTER=true
MOD_SPAM_FILTER=true

# Stream Management
ENABLE_STREAM_MANAGEMENT=true
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here

# Twitch Events
ENABLE_RAID_DETECTION=true
ENABLE_SUB_DETECTION=true
ENABLE_CHANNEL_POINTS=true
ENABLE_EMOTE_RESPONSES=true

# Rate Limiting (will be removed/shortened later)
COOLDOWN_SECONDS=8
MAX_USER_COOLDOWN=30

# Interaction Logging
ENABLE_INTERACTION_LOGGING=true
LOG_DIRECTORY=logs