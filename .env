# === MedlarTV Core Settings ===
CORE_URL=http://127.0.0.1:8000
OLLAMA_URL=http://127.0.0.1:11434

# === WebSocket Bridge Settings ===
BRIDGE_URL=ws://127.0.0.1:8765

# === Optional: LLM Configuration ===
MODEL_NAME=llama3
MEDLARTV_MAX_HISTORY=10
MEDLARTV_MAX_TOKENS=150
MEDLARTV_TEMPERATURE=0.8
MEDLARTV_TOP_P=0.95
MEDLARTV_RETRY=25

# === Twitch Message Limits ===
