SUPPORTED_LANGUAGES=en,es,fr,de,ja,ko,pt

# Response Templates
ENABLE_RESPONSE_TEMPLATES=true
MIN_TEMPLATE_VARIATION=3

# Moderation
ENABLE_AUTO_MOD=true
MOD_LINK_FILTER=true
MOD_CAPS_FILTER=true
MOD_SPAM_FILTER=true

ENABLE_STREAM_MANAGEMENT=true
